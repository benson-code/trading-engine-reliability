target/
*.class
*.jar
.idea/
*.iml
.DS_Store

# Next.js
trading-engine-ui/.next/
trading-engine-ui/.next-e2e/
trading-engine-ui/test-results/
trading-engine-ui/playwright-report/
trading-engine-ui/blob-report/
