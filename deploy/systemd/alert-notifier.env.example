# 複製到 /etc/alert-notifier.env，權限 0640 root:ubuntu：
#   sudo install -m 0640 -o root -g ubuntu alert-notifier.env /etc/alert-notifier.env
#
# LINE Messaging API 長期 token（LINE Developers Console → 你的 channel →
# Messaging API → Channel access token (long-lived)）。
# 用 broadcast，發給所有加官方帳號的好友，不需要 userId。
LINE_CHANNEL_ACCESS_TOKEN=貼上長期Token

# 外部心跳（死人開關）。DeadMansSwitch 每 5 分鐘讓 notifier GET 這個 URL 一次；
# 對方在逾時（建議 15 分鐘）沒收到時反過來通知你 —— 這是唯一能偵測
# 「整台主機連同監控一起死掉」的方法。Healthchecks.io 免費方案即可。
HEARTBEAT_URL=https://hc-ping.com/<你的-check-uuid>

# LINE 每小時最多發幾則。免費方案有每月額度，一條反覆抖動的 critical
# 配 repeat_interval: 1h 可以在幾天內把額度燒光。超過上限會壓下並計數
# （notifier_deliveries_total{outcome="suppressed"}），不會默默丟掉。
LINE_HOURLY_CAP=30
