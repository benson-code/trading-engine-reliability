{
 "uid": "payment-api-red",
 "title": "payment-api RED — 速率 / 錯誤 / 延遲",
 "description": "服務自報的 RED 指標與合成交易探測。定義見 docs/slo.md；錯誤率處理見 docs/runbooks/payment-api-error-rate.md。",
 "tags": [
  "sre",
  "red",
  "payment-api"
 ],
 "editable": true,
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "timezone": "utc",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "type": "row",
   "title": "RED — 這三個數字定義一支請求型服務",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Rate — 請求速率",
   "description": "sum(rate(payment_requests_total[5m]))。含黑箱探測與合成交易產生的流量。",
   "gridPos": {
    "h": 5,
    "w": 8,
    "x": 0,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "decimals": 2,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "targets": [
    {
     "expr": "sum(rate(payment_requests_total[5m]))",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Errors — 5xx 佔比",
   "description": "PaymentApiErrorRateHigh 的門檻是 1%。這個訊號在 /metrics 出現之前完全量不到——黑箱只打 /health，看不見 /payments 在噴 500。　⚠ 運算式刻意用 `or vector(0)` 補零：沒有 5xx 時若讓除法回傳空集合，面板會顯示「No data」——那跟「指標管線壞掉」長得一模一樣。「零錯誤」和「沒有資料」必須看得出差別。",
   "gridPos": {
    "h": 5,
    "w": 8,
    "x": 8,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 3,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.001
       },
       {
        "color": "red",
        "value": 0.01
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "targets": [
    {
     "expr": "(sum(rate(payment_requests_total{status=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(payment_requests_total[5m])), 0.0001)",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Duration — p99",
   "description": "由直方圖算出。紅色門檻 250ms 就是 SLO 的延遲門檻，而直方圖刻意有一個 le=\"0.25\" 的邊界，所以這個數字與 SLI 同源。",
   "gridPos": {
    "h": 5,
    "w": 8,
    "x": 16,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": 4,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.1
       },
       {
        "color": "red",
        "value": 0.25
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.99, sum by (le) (rate(payment_request_duration_seconds_bucket[5m])))",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "請求速率（依部署環境）",
   "description": "host = systemd 的 binance-payment-api；container = Docker。同一份程式跑在兩種環境，流量或行為出現差異時這裡看得到。",
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "axisLabel": "請求/秒"
     },
     "decimals": 2,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "transparent",
        "value": null
       }
