      "showPoints": "never",
      "axisLabel": "5xx 佔比",
      "thresholdsStyle": {
       "mode": "dashed"
      }
     },
     "decimals": 4,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "transparent",
        "value": null
       },
       {
        "color": "red",
        "value": 0.01
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "showLegend": true,
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "expr": "(sum by (deployment) (rate(payment_requests_total{status=~\"5..\"}[5m])) or (sum by (deployment) (rate(payment_requests_total[5m])) * 0)) / clamp_min(sum by (deployment) (rate(payment_requests_total[5m])), 0.0001)",
     "refId": "A",
     "legendFormat": "{{deployment}}"
    }
   ]
  },
  {
   "type": "row",
