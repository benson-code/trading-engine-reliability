   },
   "targets": [
    {
     "expr": "sum by (deployment) (rate(payment_requests_total[5m]))",
     "refId": "A",
     "legendFormat": "{{deployment}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "延遲分位數",
   "description": "p50 / p90 / p99 同一個單位、共用一個 Y 軸。虛線為 SLO 門檻 250ms。事故 #1 的 GC 停頓以「秒」計，會直接穿透這條線。",
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 14
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "drawStyle": "line",
